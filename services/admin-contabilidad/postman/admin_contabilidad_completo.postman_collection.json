{
  "info": {
    "name": "Admin-Contabilidad — Colección Completa",
    "description": "Todos los endpoints del microservicio admin-contabilidad de Pedidos Now. Cubre: Auth, Movimientos, Cobros, Bancos, Reembolsos, Compensaciones, Pagos Agentes, Dashboard, Reportes, Negocios, Restaurantes, Paquetería, Cupones, Promociones, Chats.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL",   "value": "http://localhost:3000", "type": "string" },
    { "key": "TOKEN",      "value": "",  "type": "string",  "description": "JWT — se llena automáticamente al hacer POST /api/auth/login" },
    { "key": "COBRO_ID",   "value": "1", "type": "string" },
    { "key": "REEMBOLSO_ID", "value": "1", "type": "string" },
    { "key": "MOVIMIENTO_ID", "value": "1", "type": "string" },
    { "key": "AGENTE_ID",  "value": "1", "type": "string" },
    { "key": "CUPON_ID",   "value": "1", "type": "string" },
    { "key": "PROMO_ID",   "value": "1", "type": "string" },
    { "key": "CONVERSATION_ID", "value": "3d0e8f5f-5327-11f1-b7d0-a2aa3582ff8d", "type": "string" },
    { "key": "RESOLUCION_ID", "value": "1", "type": "string" },
    { "key": "BUSINESS_ID", "value": "1", "type": "string" },
    { "key": "REPARTIDOR_ID", "value": "1", "type": "string" },
    { "key": "CUENTA_ID",  "value": "1", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{TOKEN}}", "type": "string" }]
  },
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Alberto\",\n  \"apellidos\": \"Simaj\",\n  \"email\": \"admin@test.com\",\n  \"password\": \"password123\",\n  \"tipo_usuario\": \"admin\",\n  \"rol\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.token) pm.collectionVariables.set('TOKEN', r.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/auth/me",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{TOKEN}}" }] }
          }
        },
        {
          "name": "Actualizar perfil",
          "request": {
            "method": "PUT",
            "url": "{{BASE_URL}}/api/auth/me",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{TOKEN}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Alberto\",\n  \"telefono\": \"555-1234\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Movimientos Financieros",
      "item": [
        {
          "name": "Listar movimientos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/movimientos",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "movimientos"]
            }
          }
        },
        {
          "name": "Crear movimiento",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/movimientos",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cuenta_id\": 1,\n  \"tipo\": \"ingreso\",\n  \"subtipo\": \"pedido\",\n  \"modulo_origen\": \"broker\",\n  \"referencia_id\": 1001,\n  \"monto\": 150.75,\n  \"descripcion\": \"Ingreso por pedido desde broker\",\n  \"pedido_id\": 1001,\n  \"repartidor_id\": 25,\n  \"estado\": \"procesado\"\n}"
            }
          }
        },
        {
          "name": "Obtener movimiento por ID",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/movimientos/{{MOVIMIENTO_ID}}"
          }
        },
        {
          "name": "Actualizar movimiento",
          "request": {
            "method": "PUT",
            "url": "{{BASE_URL}}/api/movimientos/{{MOVIMIENTO_ID}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"anulado\",\n  \"descripcion\": \"Movimiento corregido\"\n}"
            }
          }
        },
        {
          "name": "Eliminar movimiento",
          "request": {
            "method": "DELETE",
            "url": "{{BASE_URL}}/api/movimientos/{{MOVIMIENTO_ID}}"
          }
        },
        {
          "name": "Saldo de cuenta",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/movimientos/saldo/{{CUENTA_ID}}"
          }
        },
        {
          "name": "Movimientos por periodo",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/movimientos/periodo?inicio=2026-01-01&fin=2026-06-30",
              "query": [
                { "key": "inicio", "value": "2026-01-01" },
                { "key": "fin",    "value": "2026-06-30" }
              ]
            }
          }
        },
        {
          "name": "Estadísticas de movimientos",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/movimientos/estadisticas"
          }
        },
        {
          "name": "Test DB",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/movimientos/test"
          }
        }
      ]
    },

